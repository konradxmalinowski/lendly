WEB_HOST=web.example.internal
API_HOST=api.example.internal
SSH_USER=deploy
# Optional: address Nginx proxies /api/ to. Defaults to API_HOST; use 127.0.0.1 when web and API run on one host.
API_UPSTREAM=
# Optional: address of a TLS-terminating proxy in front of the web host. Nginx trusts its X-Forwarded-For header.
# Leave empty if clients connect directly.
TRUSTED_PROXY=
