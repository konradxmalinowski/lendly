# Copy to backend/.env for local development and fill in values. Never commit backend/.env.
# Generate keys with: openssl rand -base64 32  (JWT)  and  openssl rand -hex 32  (HMAC)
spring.profiles.active=local
DATABASE_URL=jdbc:postgresql://127.0.0.1:5433/lendly
DATABASE_USERNAME=lendly
DATABASE_PASSWORD=
LENDLY_JWT_SECRET=
LENDLY_RATE_LIMIT_HMAC_KEY=
LENDLY_PUBLIC_ORIGIN=http://localhost:4201
LENDLY_ALLOWED_ORIGINS=http://localhost:4201
LENDLY_DEMO_REGISTRATION=true
LENDLY_SECURE_COOKIES=false
# Base64 of exactly 32 random bytes, encrypts TOTP secrets: openssl rand -base64 32
# Required outside the local profile; locally MFA stays unavailable while it is empty.
LENDLY_MFA_ENCRYPTION_KEY=
# Public registration in production needs this plus a mail transport (demo flags still work).
LENDLY_REGISTRATION_ENABLED=false

# Mail for verification codes. Empty MAIL_HOST in the local profile logs the code to the backend log instead.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
LENDLY_MAIL_FROM=

# AI provider (backend only): gemini or openai. Only the selected provider's key is used.
# Leave the key empty to disable AI features; manual listing and search keep working.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
